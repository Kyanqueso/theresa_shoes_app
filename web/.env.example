# Base URL of the FastAPI backend (see ../api)
VITE_API_URL=http://localhost:8000

# Device token this browser presents as X-Device-Id on admin-gated requests.
# There is no self-service provisioning UI yet — this comes from a `devices`
# row inserted directly into the database (see api/schema.sql). One shared
# token for the shop's admin browser is the intended setup for now.
VITE_DEVICE_ID=
